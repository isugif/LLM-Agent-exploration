#!/usr/bin/env bash
# abi — open the four-harness bioinformatician "in" the folder you're standing in.
#
# Runs `python -m app` from the repo (so the `app` package imports) but resolves your data paths
# against the directory you launched from. Put this dir on your PATH, or symlink `abi` onto it:
#   ln -s "$(pwd)/bin/abi" ~/.local/bin/abi
# Then, from any project folder:  abi           (opens the app with that folder as the workdir)
#                                 abi --port 9000 --model qwen3.6:35b-a3b   (flags pass through)
set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
WORKDIR="$(pwd)"                       # the folder you're in — becomes the app's working directory

cd "$REPO"
export BIO_CHAT_WORKDIR="$WORKDIR"

if command -v conda >/dev/null 2>&1; then
  exec conda run -n nooa --no-capture-output python -m app "$@"
fi
exec python -m app "$@"                 # fall back to whatever python is active if conda is absent
